<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RestaurantGuide" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/restaurant_guide_purple</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.RestaurantGuide.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/restaurant_guide_purple</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_placeholder</item>
        <item name="postSplashScreenTheme">@style/Theme.RestaurantGuide</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
